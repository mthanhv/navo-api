# Copy to .env (git-ignored). Never commit real values.
DATABASE_URL=postgres:///navo_dev?host=/tmp
TEST_DATABASE_URL=postgres:///navo_test?host=/tmp
NAVO_ADDR=:8080
NAVO_SESSION_TTL=168h
# false only for local http development
NAVO_COOKIE_SECURE=false
NAVO_ALLOWED_ORIGINS=http://localhost:5173
NAVO_TIMEZONE=Asia/Ho_Chi_Minh
# Uploaded files (private; back them up with the database)
NAVO_FILES_DIR=var/files
# AI drafts: leave empty to keep the feature off (O-17)
ANTHROPIC_API_KEY=
# Product-news emails to customer contacts: leave the host empty to keep sending off.
# Port 587 uses STARTTLS, 465 uses TLS from the start. From is what customers see.
NAVO_SMTP_HOST=
NAVO_SMTP_PORT=587
NAVO_SMTP_USERNAME=
NAVO_SMTP_PASSWORD=
NAVO_MAIL_FROM=
# true makes every administrator turn on two-step sign-in (authenticator app) before
# doing anything else. Recommended in production; anyone may turn it on for themselves.
NAVO_REQUIRE_ADMIN_MFA=false
